{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pendelgeist-com",
  "compatibility_date": "2025-09-27",
  "main": "src/worker.js",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/graphql"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": true,
  "routes": [
    {
      "pattern": "pendelgeist.com",
      "custom_domain": true
    },
    {
      "pattern": "www.pendelgeist.com",
      "custom_domain": true
    }
  ]
}
